// The game's icon and version information (Setup reads the version to tell an update from a repair;
// scripts/build_installer.py sets it to the release number).
#include <winver.h>

1 ICON "../res/robotech.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Robotech: Battlecry Recomp"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "robotech_bc_recomp"
            VALUE "LegalCopyright", "Fan-made recompilation. Game assets are not included."
            VALUE "OriginalFilename", "robotech_bc_recomp.exe"
            VALUE "ProductName", "Robotech: Battlecry Recomp"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
